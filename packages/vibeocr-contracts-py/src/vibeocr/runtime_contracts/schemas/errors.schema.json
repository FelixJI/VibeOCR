{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeocr/protocol/v2/errors.schema.json",
  "title": "VibeOCR v2 Error Response",
  "type": "object",
  "required": ["schema_version", "code", "message", "category", "retryable"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "instance_id": {"type": ["string", "null"]},
    "code": {
      "type": "string",
      "enum": [
        "VALIDATION_ERROR",
        "QUOTA_EXCEEDED",
        "UNAUTHORIZED",
        "FORBIDDEN_LOOPBACK",
        "JOB_NOT_FOUND",
        "RESOURCE_NOT_FOUND",
        "JOB_NOT_CANCELLABLE",
        "JOB_NOT_RETRYABLE",
        "INPUT_EXPIRED",
        "PIN_CAPACITY_CONFLICT",
        "SUPERVISOR_DRAINING",
        "CANCELLED",
        "OUT_OF_MEMORY",
        "TRANSIENT_BACKEND",
        "BACKEND_UNAVAILABLE",
        "ADAPTER_PROTOCOL_VIOLATION",
        "PROTOCOL_MISMATCH",
        "INTERNAL_ERROR"
      ]
    },
    "message": {"type": "string"},
    "category": {
      "type": "string",
      "enum": [
        "validation",
        "auth",
        "not_found",
        "conflict",
        "cancelled",
        "oom",
        "transient",
        "backend_unavailable",
        "internal"
      ]
    },
    "retryable": {"type": "boolean"},
    "detail": {"type": "object"},
    "job_id": {"type": ["string", "null"]}
  }
}
