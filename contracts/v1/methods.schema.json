{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibeocr.local/contracts/v1/methods.schema.json",
  "title": "VibeOCR WorkerHost v1 methods",
  "description": "Allow-list of RPC method names and their request/response payload schemas. The envelope schema validates framing; this schema validates per-method payloads. Method names use dotted namespace ('domain.action'). Any method not present here is INVALID_REQUEST.",
  "$defs": {
    "shared_payload_ref": {
      "type": "object",
      "description": "Reference to a large binary object in Windows shared memory. Never embedded in JSON. Descriptor and ownership rules are defined in shared_payload.py and shared-payload golden fixtures.",
      "additionalProperties": false,
      "required": ["name", "size", "media_type", "sha256", "owner", "expires_unix_ms"],
      "properties": {
        "name": { "type": "string", "pattern": "^Local\\\\VibeOCR-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "Windows shared memory object name: Local\\VibeOCR-{session-uuid}-{object-uuid}, both v4 UUIDs. Tightened in Task 1.4 to match the Python store's validation and reject path injection." },
        "size": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Lowercase hex SHA-256 of the payload bytes." },
        "owner": { "type": "string", "enum": ["client", "worker"], "description": "Who created and is responsible for unlinking the segment." },
        "expires_unix_ms": { "type": "integer", "minimum": 0, "description": "Absolute expiry as unix ms; TTL-based reclaim reaps orphans past this." }
      }
    },
    "pipeline": {
      "type": "string",
      "enum": ["OCR", "PP-StructureV3", "MinerU", "PaddleOCR-VL", "TABLE_RECOGNITION", "FORMULA_RECOGNITION"],
      "description": "Inference pipeline name. Matches vibeocr.contracts.pipelines.OCRPipeline."
    },
    "backend": { "type": "string", "enum": ["cpu", "gpu"] }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "system.handshake": {
      "type": "object",
      "description": "First request after connect. Exchanges versions, capabilities, limits. Major-version mismatch -> PROTOCOL_MISMATCH.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["app_version", "protocol_version"],
          "properties": {
            "app_version": { "type": "string", "minLength": 1 },
            "protocol_version": { "const": 1 },
            "max_message_bytes": { "type": "integer", "minimum": 1024 },
            "max_shared_payload_bytes": { "type": "integer", "minimum": 0 }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["worker_version", "protocol_version", "capabilities"],
          "properties": {
            "worker_version": { "type": "string", "minLength": 1 },
            "protocol_version": { "const": 1 },
            "capabilities": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Advertised capability strings (e.g. 'ocr', 'pdf', 'qrcode', 'mineru')."
            },
            "python_version": { "type": "string" },
            "backend": { "$ref": "#/$defs/backend" },
            "max_message_bytes": { "type": "integer", "minimum": 1024 },
            "max_shared_payload_bytes": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "system.ping": {
      "type": "object",
      "description": "Liveness probe. Payload echo'd back.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nonce"],
          "properties": { "nonce": { "type": "string", "minLength": 1 } }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nonce"],
          "properties": { "nonce": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "system.shutdown": {
      "type": "object",
      "description": "Graceful shutdown request. Worker drains and exits.",
      "required": ["request", "response"],
      "properties": {
        "request": { "type": "object", "additionalProperties": false, "properties": { "reason": { "type": "string" } } },
        "response": { "type": "object", "additionalProperties": false, "required": ["acknowledged"], "properties": { "acknowledged": { "const": true } } }
      }
    },
    "task.cancel": {
      "type": "object",
      "description": "Cancel an in-flight task by task_id. Idempotent. ACK within 2s per design §7.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_id"],
          "properties": { "task_id": { "$ref": "envelope.schema.json#/$defs/uuid" } }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted", "state"],
          "properties": {
            "accepted": { "type": "boolean" },
            "state": { "type": "string", "enum": ["queued", "running", "completed", "failed", "cancelled", "unknown"] }
          }
        }
      }
    },
    "memory.release": {
      "type": "object",
      "description": "Acknowledge consumption of a shared payload so the owner may reclaim it.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": { "name": { "$ref": "#/$defs/shared_payload_ref/properties/name" } }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["released"],
          "properties": { "released": { "type": "boolean" } }
        }
      }
    },
    "ocr.recognize": {
      "type": "object",
      "description": "Single-image OCR. Image bytes transferred via shared memory; the envelope payload carries only a SharedPayloadRef plus options.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": {
            "image": { "$ref": "#/$defs/shared_payload_ref" },
            "pipeline": { "$ref": "#/$defs/pipeline" },
            "language": { "type": ["string", "null"] }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "pipeline"],
          "properties": {
            "text": { "type": "string" },
            "pipeline": { "$ref": "#/$defs/pipeline" },
            "raw_blocks": { "type": "array", "description": "Structured blocks for editor/table rendering. Items are method-defined objects." },
            "markdown_text": { "type": "string" },
            "html_text": { "type": "string" },
            "raw_text": { "type": "string" },
            "text_blocks": { "type": "array", "description": "Serialized text blocks [{text, bbox, confidence, order, ...}], for UI reconstruction of TextBlock objects." },
            "text_with_scores": { "type": "array", "description": "[[text, score], ...] pairs. Each item is a 2-element array [string, number]." },
            "content_list": { "type": "array", "description": "Structured content list (MinerU/table/formula pipelines)." },
            "image_width": { "type": "integer", "minimum": 0 },
            "image_height": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "ocr.recognize_batch": {
      "type": "object",
      "description": "Multi-image OCR. All image payloads share one options set and are processed by one engine-level batch call.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["images"],
          "properties": {
            "images": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "$ref": "#/$defs/shared_payload_ref" }
            },
            "pipeline": { "$ref": "#/$defs/pipeline" },
            "language": { "type": ["string", "null"] }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["results"],
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "anyOf": [
                  { "$ref": "#/properties/ocr.recognize/properties/response" },
                  { "type": "null" }
                ]
              }
            }
          }
        }
      }
    },
    "ocr.export": {
      "type": "object",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw_text", "markdown_text", "html_text", "raw_blocks", "output_path", "format", "overwrite"],
          "properties": {
            "raw_text": { "type": "string" }, "markdown_text": { "type": "string" }, "html_text": { "type": "string" },
            "raw_blocks": { "type": "array" }, "output_path": { "type": "string", "minLength": 1 },
            "format": { "enum": ["txt", "markdown", "html", "docx", "xlsx"] }, "overwrite": { "type": "boolean" }
          }
        },
        "response": {
          "type": "object", "additionalProperties": false, "required": ["output_path", "bytes_written"],
          "properties": { "output_path": { "type": "string", "minLength": 1 }, "bytes_written": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "pdf.open": {
      "type": "object",
      "description": "Open a PDF file and create a session. The file is referenced by an absolute path canonicalized to an allowed data/runtime/model root.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file_path"],
          "properties": { "file_path": { "type": "string", "minLength": 1 } }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "file_path", "page_count"],
          "properties": {
            "session_id": { "type": "string", "minLength": 1 },
            "file_path": { "type": "string", "minLength": 1 },
            "page_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "pdf.close": {
      "type": "object",
      "description": "Close a PDF session and release backend resources. Idempotent.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id"],
          "properties": { "session_id": { "type": "string", "minLength": 1 } }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["closed"],
          "properties": { "closed": { "type": "boolean" } }
        }
      }
    },
    "pdf.command": {
      "type": "object",
      "description": "WorkerHost-owned compatibility command for Classic PDF editor operations. The operation allow-list is enforced by the handler; no executable code crosses the boundary.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "operation", "params"],
          "properties": {
            "session_id": { "type": "string", "minLength": 1 },
            "operation": { "type": "string", "minLength": 1 },
            "params": { "type": "object" }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result"],
          "properties": { "result": {} }
        }
      }
    },
    "pdf.render_page": {
      "type": "object",
      "description": "Render a single page to a PNG image (shared payload owned by the worker). Used for both thumbnails (small size) and preview (high DPI).",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "page_index"],
          "properties": {
            "session_id": { "type": "string", "minLength": 1 },
            "page_index": { "type": "integer", "minimum": 0 },
            "size": { "type": "integer", "minimum": 16, "description": "Thumbnail target size in pixels (short edge)." },
            "dpi": { "type": "integer", "minimum": 24, "description": "Preview render DPI. When present, overrides size." }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": { "image": { "$ref": "#/$defs/shared_payload_ref" } }
        }
      }
    },
    "pdf.rotate": {
      "type": "object",
      "description": "Rotate pages by a multiple of 90 degrees. Mutation; never auto-retried.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "page_indices", "angle"],
          "properties": {
            "session_id": { "type": "string", "minLength": 1 },
            "page_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "angle": { "type": "integer", "enum": [90, -90, 180, 270], "description": "Clockwise degrees; -90 is counter-clockwise." }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page_count"],
          "properties": { "page_count": { "type": "integer", "minimum": 0, "description": "Page count after the mutation." } }
        }
      }
    },
    "pdf.delete_pages": {
      "type": "object",
      "description": "Delete pages by index. Mutation; never auto-retried.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "page_indices"],
          "properties": {
            "session_id": { "type": "string", "minLength": 1 },
            "page_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page_count"],
          "properties": { "page_count": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "pdf.add_text_layer": {
      "type": "object",
      "description": "OCR one page and write an invisible text layer. Mutation; persisted incrementally when save=true. Mirrors the production add_text_layer_batch save contract.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "page_index", "overwrite"],
          "properties": {
            "session_id": { "type": "string", "minLength": 1 },
            "page_index": { "type": "integer", "minimum": 0 },
            "overwrite": { "type": "boolean", "description": "When true, replace any existing OCR text layer." },
            "save": { "type": "boolean", "description": "When true (default), persist via incremental save." }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["written"],
          "properties": {
            "written": { "type": "boolean", "description": "True when a text layer was written for the page." },
            "saved": { "type": "boolean", "description": "True only when the batch was committed to disk." }
          }
        }
      }
    },
    "pdf.delete_text_layers": {
      "type": "object",
      "description": "Stream-delete text layers page by page. Progress events (task.progress with phase=delete) carry current/total and the current page_index; cooperative cancel stops at the page boundary. Mutation; never auto-retried.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "page_indices"],
          "properties": {
            "session_id": { "type": "string", "minLength": 1 },
            "page_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deleted_count"],
          "properties": {
            "deleted_count": { "type": "integer", "minimum": 0 },
            "residual_pages": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Pages that retain residual text after multi-pass deletion." }
          }
        }
      }
    },
    "pdf.save": {
      "type": "object",
      "description": "Save the session. With output_path null the original file is overwritten in place (aggregate compress); otherwise a copy is written. Mutation; never auto-retried.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id"],
          "properties": {
            "session_id": { "type": "string", "minLength": 1 },
            "output_path": { "type": ["string", "null"], "description": "Absolute path for save-as; null overwrites the original." }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["saved_path"],
          "properties": { "saved_path": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "pdf.start_ocr": {
      "type": "object",
      "description": "Start durable batch OCR over the requested pages. Emits task.progress events with phase (render/recognize/write/compress), current/total, page_index, state (none/processing/done/failed) and persisted flag. Cooperative cancel at page boundaries; resume via sidecar when overwrite=false. The final aggregate compress refreshes the sidecar baseline and marks the session completed.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["session_id", "file_path", "page_indices", "overwrite"],
          "properties": {
            "session_id": { "type": "string", "minLength": 1 },
            "file_path": { "type": "string", "minLength": 1, "description": "Absolute path of the PDF; used as the sidecar checkpoint key." },
            "page_indices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
            "overwrite": { "type": "boolean" },
            "sidecar_root": { "type": ["string", "null"], "description": "Isolated sidecar root for the winui-dev profile; null uses the production location." }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["completed", "failed"],
          "properties": {
            "completed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "cancelled": { "type": "boolean" },
            "compressed": { "type": "boolean" },
            "write_errors": { "type": "array", "items": { "type": "string" }, "description": "Deduplicated, ordered write-error messages aggregated across batches." }
          }
        }
      }
    },
    "settings.switch_backend": {
      "type": "object",
      "description": "Persist a backend switch (cpu/gpu). Mutation; never auto-retried. Requires a restart to take effect.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend"],
          "properties": { "backend": { "$ref": "#/$defs/backend" } }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "restart_required"],
          "properties": {
            "backend": { "$ref": "#/$defs/backend" },
            "restart_required": { "type": "boolean" }
          }
        }
      }
    },
    "settings.install_dependency": {
      "type": "object",
      "description": "Install a named runtime/model dependency. Mutation; never auto-retried. Cooperative cancel via task.cancel.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "Dependency identifier (runtime/model)." },
            "source": { "type": ["string", "null"], "description": "Optional mirror URL; null uses the default source." }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installed"],
          "properties": {
            "installed": { "type": "boolean" },
            "restarted": { "type": "boolean" },
            "name": { "type": "string" },
            "source": { "type": ["string", "null"] }
          }
        }
      }
    },
    "qrcode.decode": {
      "type": "object",
      "description": "Detect and decode QR/barcodes from an image (shared payload).",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": { "image": { "$ref": "#/$defs/shared_payload_ref" } }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codes"],
          "properties": {
            "codes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["data", "format"],
                "properties": {
                  "data": { "type": "string" },
                  "format": { "type": "string", "minLength": 1 },
                  "is_url": { "type": "boolean", "description": "True when data is a strict http/https URL (Python source of truth); drives the safe-open affordance." }
                }
              }
            }
          }
        }
      }
    },
    "qrcode.generate": {
      "type": "object",
      "description": "Generate a QR/barcode image with optional styling (size, colors, logo, text label, invert). Result returned as a shared payload (PNG) owned by the worker.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data"],
          "properties": {
            "data": { "type": "string", "minLength": 1 },
            "format": { "type": "string", "enum": ["qrcode", "barcode"], "description": "Symbol family. 'qrcode' renders a QR code; 'barcode' renders the barcode_format." },
            "barcode_format": { "type": "string", "description": "python-barcode class name when format=barcode (e.g. code128, ean13, code39). Ignored for qrcode." },
            "size": { "type": "integer", "minimum": 32, "description": "Target pixel size (short edge / height)." },
            "error_correction": { "type": "string", "enum": ["L", "M", "Q", "H"], "description": "QR error-correction level. Ignored for barcodes." },
            "fg_color": { "type": "string", "description": "Foreground color (#RRGGBB hex)." },
            "bg_color": { "type": "string", "description": "Background color (#RRGGBB hex)." },
            "invert": { "type": "boolean", "description": "Invert foreground/background after generation." },
            "logo_path": { "type": ["string", "null"], "description": "Absolute path to a logo image to embed (QR only)." },
            "logo_ratio": { "type": "number", "minimum": 0.01, "maximum": 0.9, "description": "Logo size as a fraction of QR short edge." },
            "label_text": { "type": "string", "description": "Optional text label rendered above/below the image." },
            "label_position": { "type": "string", "enum": ["bottom", "top", "none"] },
            "label_font_size": { "type": "integer", "minimum": 6 }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["image"],
          "properties": { "image": { "$ref": "#/$defs/shared_payload_ref" } }
        }
      }
    },
    "qrcode.generate_svg": {
      "type": "object",
      "description": "Generate a QR code as an SVG string (vector export; no barcode support). The worker returns the raw SVG text in the response.",
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data"],
          "properties": {
            "data": { "type": "string", "minLength": 1 },
            "error_correction": { "type": "string", "enum": ["L", "M", "Q", "H"] },
            "fg_color": { "type": "string" },
            "bg_color": { "type": "string" }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["svg"],
          "properties": { "svg": { "type": "string", "minLength": 1, "description": "Raw SVG document text." } }
        }
      }
    },
    "settings.snapshot": {
      "type": "object",
      "description": "Read-only settings snapshot. No request parameters.",
      "required": ["request", "response"],
      "properties": {
        "request": { "type": "object", "additionalProperties": false },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "preload_pipelines", "ttl_seconds"],
          "properties": {
