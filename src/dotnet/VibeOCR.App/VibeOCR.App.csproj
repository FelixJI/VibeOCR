<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>VibeOCR.App</RootNamespace>
    <AssemblyName>VibeOCR.WinUI</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkSelfContained>false</WindowsAppSdkSelfContained>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="../VibeOCR.Contracts/VibeOCR.Contracts.csproj" />
    <ProjectReference Include="../VibeOCR.Platform/VibeOCR.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="WebAssets/index.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="WebAssets/src/**/*.css;WebAssets/src/**/*.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 暴露 internal 成员给测试程序集（GitHubUpdateSource.SelectAsset 等）。
         生产程序集不受影响；仅测试可访问 internal 辅助方法。 -->
    <InternalsVisibleTo Include="VibeOCR.App.Tests" />
  </ItemGroup>
</Project>
